.{
    .name = .z53,
    .version = "0.0.0",
    .fingerprint = 0xbbc69734fb0074ce, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .tls = .{
            .url = "https://baskingspot.dev/tls/v0.4.1.tar.gz",
