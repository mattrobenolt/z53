.{
    .name = .z53,
    .version = "0.0.0",
    .fingerprint = 0xbbc69734fb0074ce, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .tls = .{
            .url = "git+https://github.com/baskingspot/tls?ref=main#a2e6066983b73a96141b779e0c109f097401aa1f",
            .hash = "tls-0.0.0-nf2MKJdWIwCWn9-xOTBOD-gg1Lmnhc9MA5dkHRxAD_nZ",
        },
        // tls pins an older stdx. z53 uses wire.Writer, which landed later,
        // so this pin is ahead until tls bumps. Collapse the two then.
        .stdx = .{
            .url = "git+https://github.com/baskingspot/stdx#4e82330bda83839b84aa86c3212b30f2d6dfddef",
            .hash = "stdx-0.0.0-CcWeguTuCQAr2Ry9Mjg84Sl4TkkEXC71yayEjZXkjThJ",
        },
        // The runner and benchmark helper never enter the executable's module graph.
        .testingx = .{
            .url = "git+https://github.com/baskingspot/testingx#c9b81a4bbf8a41f1317dc0f158ba851cebdae491",
            .hash = "testingx-0.0.0-ib95-4WvAgDlIY73PBF6aDm9FBntyPof0zrluXvyz-v5",
            .lazy = true,
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src", "tests", "scripts", "examples" },
}
